# ==============================================================================
# TruthLens Backend Environment Configuration (.env.example)
# ==============================================================================

# Active classification backend ('smaug', 'siglip', or 'legacy')
# Default: smaug (Abacus AI Smaug-AI-Image-Detector, 439M parameters)
CLASSIFIER_BACKEND=smaug

# Calibrated decision threshold for fake classification (default: 0.50)
CLASSIFIER_FAKE_THRESHOLD=0.50

# Uncertain band width around threshold for INCONCLUSIVE verdict (default: 0.10, window [0.40, 0.60])
CLASSIFIER_UNCERTAIN_BAND=0.10

# Number of native crops to evaluate for Smaug (1 or 3; recommend 1 for production deployment)
# crops=1 evaluates the center 528x528 crop (3x faster on CPU)
# crops=3 evaluates start, center, and end crops along the long dimension
SMAUG_CROPS=1

# Optional: Hugging Face User Access Token (read access) to avoid anonymous rate limits
HF_TOKEN=

# Directory path inside container/system for caching downloaded Hugging Face model weights
HF_HOME=/app/cache/huggingface

# Allowed CORS origins (comma-separated, no trailing slashes)
# In production, replace with your live frontend domain on Vercel
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://new-project-theta-taupe.vercel.app

# Server port binding (dynamically assigned by Render or Hugging Face Spaces; fallback 7860)
PORT=7860
