# ==============================================================================
# TruthLens Frontend Environment Configuration
# ==============================================================================

# Backend FastAPI API Base URL
#
# 1. Local Development (default):
#    Point to your local uvicorn FastAPI server
VITE_API_BASE_URL=http://127.0.0.1:8000

# 2. Production Deployment on Vercel:
#    Set this in Vercel Dashboard -> Project Settings -> Environment Variables:
#    VITE_API_BASE_URL=https://truthlens-backend.onrender.com
#    (Do NOT include a trailing slash)
